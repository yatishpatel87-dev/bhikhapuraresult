{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and school configuration document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "schoolTagline": { "type": "string", "maxLength": 300 },
        "schoolAddress": { "type": "string", "maxLength": 500 },
        "academicYear": { "type": "string", "maxLength": 50 },
        "passingPercentage": { "type": "number" },
        "principalName": { "type": "string", "maxLength": 100 },
        "calculationMethod": { "type": "string", "maxLength": 50 },
        "showRankInReportCard": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record in standard 6, 7, or 8",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "standard": { "type": "number" },
        "division": { "type": "string", "maxLength": 10 },
        "rollNumber": { "type": "number" },
        "grNumber": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 200 },
        "dob": { "type": "string", "maxLength": 50 },
        "gender": { "type": "string", "maxLength": 20 },
        "attendance": { "type": "object" },
        "remarks": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "standard", "division", "rollNumber", "grNumber", "name"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic subject curriculum definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 50 },
        "standards": { "type": "array" },
        "maxMarks": { "type": "object" },
        "patrakAMaxMarks": { "type": "number" },
        "weightage": { "type": "number" }
      },
      "required": ["id", "name", "standards", "maxMarks", "patrakAMaxMarks"]
    },
    "Result": {
      "title": "Result",
      "description": "Student marks across quarterly tests, semesters, Patrak A, and Patrak B",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "standard": { "type": "number" },
        "division": { "type": "string", "maxLength": 10 },
        "marks": { "type": "object" },
        "patrakA": { "type": "object" },
        "patrakB": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["studentId", "standard"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and school configuration settings"
    },
    "/users/{userId}/students/{studentId}": {
      "schema": "Student",
      "description": "Student records belonging to the authenticated teacher"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Subject definitions belonging to the authenticated teacher"
    },
    "/users/{userId}/results/{studentId}": {
      "schema": "Result",
      "description": "Examination marks and Patrak A & B results belonging to the authenticated teacher"
    }
  }
}
